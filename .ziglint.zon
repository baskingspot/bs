.{
    // Left out, because they are inputs rather than bs's code, and ziglint
    // has no exclude list, so the directories around them are named one by
    // one: tools/diag/eval/seeds holds sample user programs for the
    // diagnostics eval, written as users write them, and
    // bench/workloads/zig holds the build options module zig's build
    // generates, checked in as generated.
    .paths = .{
        "build.zig",
        "src",
        "tools/conformance",
        "tools/edithunt",
        "bench/realworld",
        "bench/runtime",
        "bench/workloads/hello",
        "bench/workloads/vaxis-build",
    },
    .rules = .{
        // bs keeps long lines: tables of flags and messages read better
        // unwrapped.
        .Z024 = .{ .enabled = false },
    },
}
