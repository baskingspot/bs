#!/usr/bin/env bash
# Installs the pinned upstream Zig toolchain (used to build zap and as the
# reference/oracle compiler) and the matching upstream source tree (for
# test/behavior and reading Sema/InternPool). Idempotent.
set -euo pipefail

ZIG_VERSION=0.17.0
ZIG_BIN_SHA=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026
ZIG_SRC_SHA=b6c7f1728f043700d6529bac980800792f824256a9d2f1839b3d62beed0b8abd

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cache="$HOME/.cache/zap"
mkdir -p "$cache" "$HOME/.local/bin"

fetch() { # url sha dest_dir
  local url=$1 sha=$2 dest=$3 tmp
  if [ -d "$dest" ]; then echo "have $dest"; return; fi
  echo "fetching $url"
  tmp="$(mktemp)"
  curl -fsSL "$url" -o "$tmp"
  echo "$sha  $tmp" | sha256sum -c --quiet
  mkdir -p "$dest.tmp"
  tar -xJf "$tmp" -C "$dest.tmp" --strip-components=1
  mv "$dest.tmp" "$dest"
  rm -f "$tmp"
}

time fetch "https://ziglang.org/download/$ZIG_VERSION/zig-x86_64-linux-$ZIG_VERSION.tar.xz" \
  "$ZIG_BIN_SHA" "$cache/zig-$ZIG_VERSION"
time fetch "https://ziglang.org/download/$ZIG_VERSION/zig-$ZIG_VERSION.tar.xz" \
  "$ZIG_SRC_SHA" "$cache/zig-$ZIG_VERSION-src"

ln -sfn "$cache/zig-$ZIG_VERSION/zig" "$HOME/.local/bin/zig"
ln -sfn "$cache/zig-$ZIG_VERSION-src" "$repo_root/upstream"

zig version
