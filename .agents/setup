#!/usr/bin/env bash
# Installs the pinned upstream Zig toolchain (used to build bs and as the
# reference/oracle compiler) and the matching upstream source tree (for
# test/behavior and reading Sema/InternPool). Idempotent. Runs on
# x86_64-linux (orbs) and aarch64-macos (Mac satellites).
set -euo pipefail

ZIG_VERSION=0.17.1
ZIG_SRC_SHA=1e89bf06610b769a8c77676c6c8d54b093a0db60f4891f2f91014829012f0e24
# The org's pull-through cache in front of the Zig community mirrors. The
# sha256 below still checks the bytes, so the mirror is not a trust anchor.
MIRROR=https://zig.baskingspot.dev

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)
    ZIG_HOST=x86_64-linux
    ZIG_BIN_SHA=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a
    ;;
  Darwin-arm64)
    ZIG_HOST=aarch64-macos
    ZIG_BIN_SHA=75f1bc7a1e9852f17ec9a0c1895f767c4ec56d46bc8a834920eece1d0359dd8d
    ;;
  *)
    echo "unsupported host: $(uname -s)-$(uname -m)" >&2
    exit 1
    ;;
esac

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cache="$HOME/.cache/bs"
mkdir -p "$cache" "$HOME/.local/bin"

sha256() { # file
  if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi
}

fetch() { # url sha dest_dir
  local url=$1 sha=$2 dest=$3 tmp got
  if [ -d "$dest" ]; then echo "have $dest"; return; fi
  echo "fetching $url"
  tmp="$(mktemp)"
  curl -fsSL "$url" -o "$tmp"
  got="$(sha256 "$tmp" | cut -d' ' -f1)"
  if [ "$got" != "$sha" ]; then
    echo "sha256 mismatch for $url: got $got, want $sha" >&2
    rm -f "$tmp"
    exit 1
  fi
  rm -rf "$dest.tmp"
  mkdir -p "$dest.tmp"
  tar -xJf "$tmp" -C "$dest.tmp" --strip-components=1
  mv "$dest.tmp" "$dest"
  rm -f "$tmp"
}

# The x86_64-linux binary keeps its original directory name, so existing
# orb snapshots stay valid.
bin_dir="$cache/zig-$ZIG_VERSION"
[ "$ZIG_HOST" = x86_64-linux ] || bin_dir="$cache/zig-$ZIG_HOST-$ZIG_VERSION"

time fetch "$MIRROR/zig-$ZIG_HOST-$ZIG_VERSION.tar.xz" \
  "$ZIG_BIN_SHA" "$bin_dir"
time fetch "$MIRROR/zig-$ZIG_VERSION.tar.xz" \
  "$ZIG_SRC_SHA" "$cache/zig-$ZIG_VERSION-src"

# Orbs are disposable, so zig goes on PATH there. A Mac satellite is the
# owner's own machine with its own zig; don't shadow it. Use
# ~/.cache/bs/zig-aarch64-macos-$ZIG_VERSION/zig explicitly there.
if [ "$ZIG_HOST" = x86_64-linux ]; then
  ln -sfn "$bin_dir/zig" "$HOME/.local/bin/zig"
fi
ln -sfn "$cache/zig-$ZIG_VERSION-src" "$repo_root/upstream"

"$bin_dir/zig" version

# `zig build` compiles its build runner into the global cache once per
# cache, about 85 s on a 4-vCPU orb; compiling it here keeps it out of each
# orb's first `zig build test`. Orbs only.
if [ "$ZIG_HOST" = x86_64-linux ]; then
  (cd "$repo_root" && time "$bin_dir/zig" build --help >/dev/null)
fi

# monstar, a C acceptance target in tools/corpus, links the system's
# Wayland, fontconfig, freetype, harfbuzz and xkbcommon and needs ncurses'
# `tic`. It wants Wayland 1.25 and wayland-protocols 1.49, newer than
# Debian 12's, so those two are built into /usr/local. raylib-zig, another
# corpus project, links X11 and GL. qemu-user-static runs aarch64-linux
# binaries (the conformance harness and run tests), and libc6-arm64-cross
# is the glibc of those that link it (qemu -L /usr/aarch64-linux-gnu).
# Orbs only.
WAYLAND_VERSION=1.25.0
WAYLAND_SHA=c065f040afdff3177680600f249727e41a1afc22fccf27222f15f5306faa1f03
WAYLAND_PROTOCOLS_VERSION=1.49
WAYLAND_PROTOCOLS_SHA=ec4c8f74942d6dff7ace8b4ce4764f0ef9ff618a935d974ea77edee2ad240b14

meson_install() { # url sha name [meson options...]
  local url=$1 sha=$2 src="$cache/$3"
  shift 3
  fetch "$url" "$sha" "$src"
  rm -rf "$src/build"
  meson setup "$src/build" "$src" --prefix=/usr/local "$@" >/dev/null
  ninja -C "$src/build" >/dev/null
  sudo ninja -C "$src/build" install >/dev/null
}

if [ "$ZIG_HOST" = x86_64-linux ] && command -v apt-get >/dev/null; then
  missing=""
  for p in meson ninja-build pkg-config libffi-dev libexpat1-dev libxml2-dev \
    libfontconfig-dev libfreetype-dev libharfbuzz-dev libxkbcommon-dev ncurses-bin \
    libx11-dev libxrandr-dev libxinerama-dev libxi-dev libxcursor-dev libgl-dev \
    qemu-user-static libc6-arm64-cross; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "ok installed" || missing="$missing $p"
  done
  if [ -n "$missing" ]; then
    sudo apt-get update -qq
    # shellcheck disable=SC2086 # one word per package
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $missing >/dev/null
  fi
  if [ "$(pkg-config --modversion wayland-client 2>/dev/null)" != "$WAYLAND_VERSION" ]; then
    meson_install "https://gitlab.freedesktop.org/wayland/wayland/-/releases/$WAYLAND_VERSION/downloads/wayland-$WAYLAND_VERSION.tar.xz" \
      "$WAYLAND_SHA" "wayland-$WAYLAND_VERSION" -Ddocumentation=false -Dtests=false
    sudo ldconfig
  fi
  if [ "$(pkg-config --modversion wayland-protocols 2>/dev/null)" != "$WAYLAND_PROTOCOLS_VERSION" ]; then
    meson_install "https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/$WAYLAND_PROTOCOLS_VERSION/downloads/wayland-protocols-$WAYLAND_PROTOCOLS_VERSION.tar.xz" \
      "$WAYLAND_PROTOCOLS_SHA" "wayland-protocols-$WAYLAND_PROTOCOLS_VERSION" -Dtests=false
  fi
  pkg-config --modversion wayland-client wayland-protocols
fi
